# MySQL 连接配置（复制为 .env 后填写）
# 仅 mysql / auto 模式需要；纯 sqlite 模式无需安装 MySQL，这些项可留空
AIHUB_MYSQL_HOST=127.0.0.1
AIHUB_MYSQL_PORT=3306
AIHUB_MYSQL_USER=root
AIHUB_MYSQL_PASSWORD=your_password_here
AIHUB_MYSQL_DB=ai_task_hub

# 测试库（pytest 使用）
AIHUB_MYSQL_TEST_DB=ai_task_hub_test

# 存储后端：sqlite（默认，推荐）| mysql | auto
# - sqlite（默认，推荐）：直接用本地 SQLite 文件，零依赖开箱即用，分发版开箱可用
# - mysql：用本机 MySQL（需自行安装配置），连不上即启动失败
# - auto：优先连接本机 MySQL，连不上自动降级 SQLite
AIHUB_DB_BACKEND=sqlite

# SQLite 数据文件路径；留空使用默认 %APPDATA%\AI Task Hub\data.sqlite
# （%APPDATA% 在配置文件中不会展开，如需自定义请填绝对路径）
AIHUB_SQLITE_PATH=
