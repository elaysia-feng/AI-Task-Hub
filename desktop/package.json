{
  "name": "ai-task-hub-desktop",
  "version": "0.1.11",
  "author": "elaysia-feng <qskaouayshuayszas@gmail.com>",
  "private": true,
  "description": "AI Task Hub 桌面端 — 多 AI 平台任务中心",
  "main": "./out/main/index.js",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "predev": "npm run ensure:electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "npm run ensure:electron",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predist": "npm run ensure:electron && npm run ensure:nsis && npm run ensure:backend",
    "dist": "npm run build && node scripts/electron-dist.mjs",
    "predist:publish": "npm run ensure:electron && npm run ensure:nsis && npm run ensure:backend",
    "dist:publish": "npm run build && node scripts/electron-dist.mjs --publish always",
    "predist:local": "npm run ensure:electron && npm run ensure:nsis && npm run ensure:backend && node scripts/apply-user-icon.mjs",
    "dist:local": "npm run build && node scripts/electron-dist.mjs --publish never",
    "ensure:backend": "node scripts/ensure-backend.mjs",
    "ensure:nsis": "node scripts/ensure-nsis.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.ai-task-hub.desktop",
    "productName": "AI Task Hub",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "../packaging/dist/aihub-backend.exe",
        "to": "backend/aihub-backend.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "artifactName": "AI-Task-Hub-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AI Task Hub",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "AI-Task-Hub-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "elaysia-feng",
      "repo": "AI-Task-Hub"
    }
  }
}
