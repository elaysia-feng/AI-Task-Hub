{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-task-hub.local/schemas/agent-event.json",
  "title": "AgentEvent",
  "description": "AI Task Hub 统一事件协议。各平台 Adapter 必须将原始事件转换为该格式后 POST 到 /api/events。",
  "type": "object",
  "required": ["source", "eventType"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["CHATGPT", "CLAUDE_CODE", "CODEX", "OTHER"],
      "description": "事件来源平台"
    },
    "eventType": {
      "type": "string",
      "enum": ["TASK_STARTED", "TASK_NEEDS_INPUT", "TASK_COMPLETED", "TASK_FAILED", "TASK_VIEWED", "TASK_IGNORED"],
      "description": "事件类型"
    },
    "externalTaskId": {
      "type": ["string", "null"],
      "description": "平台侧的任务/会话 ID，用于幂等去重。缺省时服务端视为新任务。"
    },
    "title": {
      "type": ["string", "null"],
      "description": "任务标题"
    },
    "contentPreview": {
      "type": ["string", "null"],
      "description": "任务内容摘要，例如等待输入的问题、错误信息"
    },
    "projectPath": {
      "type": ["string", "null"],
      "description": "项目目录，用于打开终端恢复会话"
    },
    "openTarget": {
      "type": ["string", "null"],
      "enum": ["browser", "terminal", "none", null],
      "description": "点击任务时的打开方式"
    },
    "openUrl": {
      "type": ["string", "null"],
      "description": "浏览器打开地址（如 ChatGPT 对话链接）"
    },
    "createdAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "事件发生时间（ISO 8601），缺省时以服务端接收时间为准"
    }
  }
}
